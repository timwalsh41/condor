# ── Database (local development) ──────────────────────────────────────────────
# Connection string for the backend to reach PostgreSQL.
DATABASE_URL=postgresql+asyncpg://condor_user:condor_dev@localhost/condor_db

# ── Video storage (local development) ─────────────────────────────────────────
VIDEO_STORAGE_PATH=./video_storage

# ── Log level ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── PostgreSQL (Docker deployment) ────────────────────────────────────────────
# These configure the postgres container image in docker-compose.yml.
# Change the password for production.
POSTGRES_USER=condor_user
POSTGRES_PASSWORD=condor_dev
POSTGRES_DB=condor_db

# ── Host port mapping (Docker deployment) ─────────────────────────────────────
FRONTEND_PORT=3443         # HTTPS (primary access)
FRONTEND_HTTP_PORT=3000    # HTTP (redirects to HTTPS)
BACKEND_PORT=8000          # Optional direct API access

# ── Version override (Docker deployment) ──────────────────────────────────────
# Normally resolved from git tags by scripts/deploy.sh.
# Set this to override the version string baked into the image.
# CONDOR_VERSION=v0.1.4
