# Frontend Dockerfile — Production image for Condor web application
#
# Multi-stage build:
#   1. builder  — Node 20, install deps, compile TypeScript, build Vite bundle
#   2. runtime  — nginx:alpine serving the static bundle + proxying to backend
#
# Compatible with linux/amd64 and linux/arm64 (Raspberry Pi 4).

# ── Stage 1: build ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Allow callers to pass an explicit version string (e.g. from git tag on the
# host). If omitted, set-version.sh falls back to git resolution inside the
# build — which works for local dev but requires .git in the build context.
ARG VERSION=

# Copy package files first (layer cache-friendly)
COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci

# Copy frontend source
COPY frontend/ ./

# Copy scripts and resolve version from git before build
COPY scripts/ ./scripts/
RUN chmod +x scripts/set-version.sh && PROJECT_ROOT=/app scripts/set-version.sh "$VERSION"

# Build production bundle (tsc + vite build)
RUN npm run build

# ── Stage 2: runtime (nginx) ───────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Install openssl for self-signed certificate generation
RUN apk add --no-cache openssl

# Generate a self-signed TLS certificate valid for 10 years.
# This enables HTTPS so that secure-context-only browser APIs (WebCodecs,
# etc.) work when the app is served from a local network host.
# Users will see a browser security warning on first visit and must add
# a permanent exception — this is expected for self-signed certs.
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 \
      -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/condor.key \
      -out    /etc/nginx/ssl/condor.crt \
      -subj   "/CN=condor-local/O=Condor/C=US"

# Copy compiled assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (single-page app + API reverse-proxy)
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
