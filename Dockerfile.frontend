# Frontend Dockerfile — Production image for Condor web application
#
# Multi-stage build:
#   1. builder  — Node 20, install deps, compile TypeScript, build Vite bundle
#   2. runtime  — nginx:alpine serving the static bundle + proxying to backend
#
# Compatible with linux/amd64 and linux/arm64 (Raspberry Pi 4).

# ── Stage 1: build ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first (layer cache-friendly)
COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci

# Copy frontend source
COPY frontend/ ./

# Copy scripts and resolve version from git before build
COPY scripts/ ./scripts/
RUN chmod +x scripts/set-version.sh && PROJECT_ROOT=/app scripts/set-version.sh

# Build production bundle (tsc + vite build)
RUN npm run build

# ── Stage 2: runtime (nginx) ───────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Copy compiled assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (single-page app + API reverse-proxy)
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
