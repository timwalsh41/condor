# Frontend Dockerfile — Production image for Condor web application
#
# Multi-stage build:
#   1. builder  — Node 20, install deps, compile TypeScript, build Vite bundle
#   2. runtime  — nginx:alpine serving the static bundle + proxying to backend
#
# Compatible with linux/amd64 and linux/arm64 (Raspberry Pi 4).

# ── Stage 1: build ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# set-version.sh expects the repo layout (frontend/package.json,
# frontend/src/version.ts, etc.) under PROJECT_ROOT, so we preserve the
# frontend/ directory structure rather than flattening into /app/ directly.
ARG VERSION=

WORKDIR /app/frontend

# Copy package files first (layer cache-friendly)
COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci

# Copy frontend source
COPY frontend/ ./

# Copy scripts and resolve version from git before build.
# PROJECT_ROOT=/app so the script finds /app/frontend/package.json etc.
COPY scripts/ /app/scripts/
RUN chmod +x /app/scripts/set-version.sh && PROJECT_ROOT=/app /app/scripts/set-version.sh "$VERSION"

# Build production bundle (tsc + vite build)
RUN npm run build

# ── Stage 2: runtime (nginx) ───────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Copy pre-generated TLS certificate (see scripts/generate-cert.sh).
# The public cert is committed to the repo; the private key is gitignored.
COPY frontend/ssl/ /etc/nginx/ssl/
# Copy compiled assets (dist is at /app/frontend/dist after the restructured build)
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copy nginx configuration (single-page app + API reverse-proxy)
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]

